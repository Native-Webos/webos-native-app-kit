+/* webos-native-app-kit addition: keep the latest relaunch message for SDL_webOSTakeRelaunchMessage. */
+static SDL_SpinLock s_relaunchLock = 0;
+static char *s_relaunchMessage = NULL;
+
+static void keepRelaunchMessage(const char *message)
+{
+    char *copy = message ? SDL_strdup(message) : NULL;
+    SDL_AtomicLock(&s_relaunchLock);
+    SDL_free(s_relaunchMessage); /* a newer relaunch replaces one the app has not taken yet */
+    s_relaunchMessage = copy;
+    SDL_AtomicUnlock(&s_relaunchLock);
+}
+
+char *SDL_webOSTakeRelaunchMessage(void)
+{
+    char *message;
+    SDL_AtomicLock(&s_relaunchLock);
+    message = s_relaunchMessage;
+    s_relaunchMessage = NULL;
+    SDL_AtomicUnlock(&s_relaunchLock);
+    return message;
+}
